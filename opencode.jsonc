{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "plugin": [
    "@henadev/opencode-anthropic-auth@0.1.0",
    "opencode-codex-websearch@0.1.1",
  ],
  "lsp": {
    "typescript": {
      "command": [
        "sh",
        "-c",
        "exec \"$(bunx @effect/tsgo get-exe-path)\" --lsp --stdio",
      ],
    },
  },
}
