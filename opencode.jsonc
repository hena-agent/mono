{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "plugin": [
    "@henadev/opencode-anthropic-auth@0.1.0",
  ],
  "lsp": {
    "typescript": {
      "command": [
        "sh",
        "-c",
        "exec \"$(bunx @effect/tsgo get-exe-path)\" --lsp --stdio",
      ],
      "extensions": [".ts", ".tsx", ".mts", ".cts"],
    },
  },
}
