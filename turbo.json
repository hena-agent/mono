{
  "$schema": "./node_modules/turbo/schema.json",
  "globalDependencies": ["tsconfig.base.json", "vitest.config.mjs"],
  "tasks": {
    "build": {
      "dependsOn": ["//#workspace-scripts", "^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["//#workspace-scripts", "^typecheck"]
    },
    "test": {
      "dependsOn": ["//#workspace-scripts", "^typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/**",
        "!$TURBO_ROOT$/**/.git/**",
        "!$TURBO_ROOT$/**/.stryker-tmp/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/coverage/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/reports/**"
      ],
      "outputs": ["coverage/**"]
    },
    "mutation": {
      "dependsOn": ["//#workspace-scripts", "^typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/**",
        "!$TURBO_ROOT$/**/.git/**",
        "!$TURBO_ROOT$/**/.stryker-tmp/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/coverage/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/reports/**"
      ],
      "outputs": ["reports/mutation/**"]
    },
    "//#lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/**",
        "!$TURBO_ROOT$/**/.git/**",
        "!$TURBO_ROOT$/**/.stryker-tmp/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/coverage/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/reports/**"
      ]
    },
    "//#fmt": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/**",
        "!$TURBO_ROOT$/**/.git/**",
        "!$TURBO_ROOT$/**/.stryker-tmp/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/coverage/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/reports/**"
      ]
    },
    "//#ban-types": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/**",
        "!$TURBO_ROOT$/**/.git/**",
        "!$TURBO_ROOT$/**/.stryker-tmp/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/coverage/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/reports/**"
      ]
    },
    "//#dupes": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/**",
        "!$TURBO_ROOT$/**/.git/**",
        "!$TURBO_ROOT$/**/.stryker-tmp/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/coverage/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/reports/**"
      ],
      "outputs": ["reports/jscpd/**"]
    },
    "//#knip": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/**",
        "!$TURBO_ROOT$/**/.git/**",
        "!$TURBO_ROOT$/**/.stryker-tmp/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/coverage/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/reports/**"
      ]
    },
    "//#metrics": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/**",
        "!$TURBO_ROOT$/**/.git/**",
        "!$TURBO_ROOT$/**/.stryker-tmp/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/coverage/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/reports/**"
      ],
      "outputs": ["reports/metrics.json"]
    },
    "//#pins": {
      "inputs": [
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/packages/*/stryker.config.json",
        "$TURBO_ROOT$/.github/**",
        "$TURBO_ROOT$/**/action.yml",
        "$TURBO_ROOT$/**/action.yaml",
        "$TURBO_ROOT$/packages/ci-gates/src/index.ts",
        "$TURBO_ROOT$/packages/ci-gates/src/pins.ts",
        "$TURBO_ROOT$/packages/core/src/index.ts",
        "$TURBO_ROOT$/packages/core/src/json.ts",
        "$TURBO_ROOT$/vitest.config.mjs"
      ]
    },
    "//#gate-comments": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/**",
        "!$TURBO_ROOT$/**/.git/**",
        "!$TURBO_ROOT$/**/.stryker-tmp/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/coverage/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/reports/**"
      ]
    },
    "//#production-scope": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/packages/ci-gates/src/files.ts",
        "$TURBO_ROOT$/packages/ci-gates/src/index.ts",
        "$TURBO_ROOT$/packages/ci-gates/src/production.ts"
      ]
    },
    "//#typecheck-all": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/**",
        "!$TURBO_ROOT$/**/.git/**",
        "!$TURBO_ROOT$/**/.stryker-tmp/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/coverage/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/reports/**"
      ]
    },
    "//#workspace-scripts": {
      "inputs": [
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/packages/ci-gates/src/index.ts",
        "$TURBO_ROOT$/packages/ci-gates/src/workspaces.ts",
        "$TURBO_ROOT$/packages/core/src/index.ts",
        "$TURBO_ROOT$/packages/core/src/json.ts"
      ]
    }
  }
}
